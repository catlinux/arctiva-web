---
import Base from '../../layouts/Base.astro';
import PageHead from '../PageHead.astro';
import StatusTag from '../StatusTag.astro';
import Icon from '../Icon.astro';
import { type Lang } from '../../i18n/routes';
import { useT } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { d, u, site } = useT(lang);
const m = u.meta.roadmap;
---
<Base lang={lang} page="roadmap" title={m.title} description={m.desc}>
  <PageHead title={d.roadmap_h} lead={d.roadmap_more} />
  <section class="sec">
    <div class="wrap">
      <ol class="timeline">
        {d.roadmap.map((r) => (
          <li class={`tl tl-${r.s}`}>
            <span class="tl-v">{r.v}</span>
            <div>
              <h3>{r.n} <StatusTag lang={lang} s={r.s} /></h3>
              <p>{r.t}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="more">
        <a class="link-arrow" href={site.links.roadmap[lang]} target="_blank" rel="noopener noreferrer">{d.link_roadmap}<Icon name="arrow" /></a>
      </p>
    </div>
  </section>
</Base>
